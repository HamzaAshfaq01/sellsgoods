{
  "name": "sellsgoods",
  "version": "2.0.0",
  "type": "module",
  "description": "Application built with the MERN stack",
  "main": "server.js",
  "scripts": {
    "start": "node api/index.js",
    "server": "nodemon api/index.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "node api/seeder",
    "data:destroy": "node api/seeder -d",
    "build": "npm install && npm install --prefix frontend && npm run build --prefix frontend",
    "generate-toc": "markdown-toc -i readme.md"
  },
  "dependencies": {
    "@ant-design/charts": "^2.2.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/styled-engine": "^7.0.2",
    "@mui/x-charts": "^7.28.0",
    "antd": "^5.24.6",
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^0.483.0",
    "mongoose": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "react-countup": "^6.5.3",
    "react-icons": "^5.5.0",
    "recharts": "^2.15.2",
    "vanilla-tilt": "^1.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "concurrently": "^7.6.0",
    "markdown-toc": "^1.2.0",
    "ngrok": "^5.0.0-beta.2",
    "nodemon": "^2.0.21"
  }
}
